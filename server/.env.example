# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/parksecure
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production

# Public base URL of this API (used in approval links and upload URLs)
APP_BASE_URL=https://parksecure-api.onrender.com

# --- Initial super admin (used by `npm run seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Optional integrations ---
# Comma-separated allowed origins, or * for any
CORS_ORIGINS=*

# SMTP for exit-approval and invite emails (any provider: Gmail, Resend, Mailgun, SES...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ParkSecure <no-reply@yourdomain.com>

# Paystack (NGN payments)
PAYSTACK_SECRET_KEY=

# Plate Recognizer API for AI license plate recognition (platerecognizer.com)
PLATE_RECOGNIZER_TOKEN=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Misc
JWT_EXPIRES_IN=30d
CRON_ENABLED=true
PORT=4000

{
  "expo": {
    "name": "ParkSecure",
    "slug": "parksecure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parksecure.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ParkSecure uses the camera to scan vehicle QR codes and photograph declared items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.parksecure.app",
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ParkSecure uses the camera to scan vehicle QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ParkSecure needs photo access to attach vehicle and item photos."
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {}
  }
}
